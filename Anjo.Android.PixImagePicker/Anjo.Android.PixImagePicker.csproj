<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.PixImagePicker</PackageId>
		<PackageVersion>1.6.3</PackageVersion>
		<AssemblyVersion>1.6.3</AssemblyVersion>
		<FileVersion>1.6.3</FileVersion>
		<Version>1.6.3</Version>
		<Title>Anjo Android Akshay Sharma's PixImagePicker SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.PixImagePicker</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - Akshay Sharma's PixImagePicker SDK</Description>
		<PackageReleaseNotes>Akshay Sharma's PixImagePicker SDK v1.6.3</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, file-picker, whatsapp, whatsapp-ui, picker, image-picker, photo-picker, camera-picker, image, video, camera</PackageTags>
		<Summary>Akshay Sharma's PixImagePicker. Pix is a Whatsapp image picker replica. with this, you can integrate an image picker just like WhatsApp.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\piximagepicker-1.6.3.aar" />
	</ItemGroup> 
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup> 
	<ItemGroup>
	  <PackageReference Include="Xamarin.Android.Glide" Version="4.15.1.2" />
	  <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.5" />
	  <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.1.0-beta02" />
	  <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.1.0-beta02" />
	  <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.1.0-beta02" />
	  <PackageReference Include="Xamarin.AndroidX.Core" Version="1.12.0.2" />
	  <PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.1.2.1" />
	  <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.6.1.2" />
	  <PackageReference Include="Xamarin.Google.Android.Material" Version="1.10.0.1" />
	  <PackageReference Include="Xamarin.Kotlin.StdLib" Version="1.9.10.2" />
	  <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.7.3.2" />
	</ItemGroup>
</Project>